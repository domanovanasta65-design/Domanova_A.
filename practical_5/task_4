PI = 3.14

def calculate_rectangle_area(width, height):
    """Вычисляет площадь прямоугольника."""
    return width * height

def calculate_cirkle_area(radius):
    """Вычисляет площадь круга."""
    return PI * (radius**2)

# Вводим стороны прямоугольника через пробел
w, h = map(float, input("Введите w и h через пробел: ").split())
res_rect = calculate_rectangle_area(w, h)
print(f"Площадь прямоугольника: {res_rect:.2f}")

r = float(input("Введите радиус r: "))
res_circle= calculate_cirkle_area(r)
print(f"Площадь круга: {res_circle:.2f}")
